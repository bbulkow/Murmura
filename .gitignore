# ESP-IDF / ESP-ADF build output
build/
sdkconfig
sdkconfig.old

# ESP-IDF managed components (downloaded automatically — derived from dependencies.lock)
managed_components/

# ESP-IDF / CMake generated files
.cmake/
CMakeFiles/

# Partition tables (generated)
*.bin

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Environment / secrets
*.env
envs.local.ps1

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp
*.swo

# Claude Code
.claude/

# Build log (generated by esp-build.ps1)
build_output.txt

# mur-config-server working copy
mur-config-server/mur_config_server/

# mur-scene-server runtime state (scene names, active scene, schedules)
mur-scene-server/mur_scene_server/

# device-manager runtime data
device-manager/device_map.json

# mur-abs-gateway operator-edited state (created and rewritten by the UI)
mur-abs-gateway/abstract_triggers.json
