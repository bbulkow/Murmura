[Unit]
Description=Mur Config Server - ESP32 Device Management Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root solely to bind the privileged port 80. The narrower alternative
# is User=pi plus AmbientCapabilities=CAP_NET_BIND_SERVICE; this deployment
# chose root. Note the consequence: files the dashboard creates under
# /home/pi/Murmura (device-manager/device_map.json, uploads, ensemble config
# rewrites) end up owned by root, so the CLI tools in device-manager/ may need
# sudo afterwards.
User=root
Group=root
WorkingDirectory=/home/pi/Murmura/mur-config-server
Environment="PATH=/home/pi/Murmura/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_ENV=production"
Environment="MUR_CONFIG_SERVER_PORT=80"
ExecStart=/home/pi/Murmura/venv/bin/python /home/pi/Murmura/mur-config-server/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mur-config-server

[Install]
WantedBy=multi-user.target
