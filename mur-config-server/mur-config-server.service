[Unit]
Description=Mur Config Server - ESP32 Device Management Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brian
Group=brian
WorkingDirectory=/home/brian/Murmura/mur-config-server
Environment="PATH=/home/brian/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_ENV=production"
Environment="MUR_CONFIG_SERVER_PORT=8765"
ExecStart=/usr/bin/python3 /home/brian/Murmura/mur-config-server/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mur-config-server

[Install]
WantedBy=multi-user.target
