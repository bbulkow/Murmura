[Unit]
Description=Mur Abs Gateway - abstract-trigger Haven Trigger Server bridge for Murmura ESP32 devices
After=network-online.target trigger.service
Wants=network-online.target
Conflicts=mur-gateway.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Murmura/mur-abs-gateway
Environment="PATH=/home/pi/Murmura/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/Murmura/venv/bin/python /home/pi/Murmura/mur-abs-gateway/mur_abs_gateway.py --trigger-host localhost --trigger-port 5002
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mur-abs-gateway

[Install]
WantedBy=multi-user.target
