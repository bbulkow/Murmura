[Unit]
Description=Mur Conductor - ensemble playback coordinator for Murmura devices
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Murmura/mur-conductor
Environment="PATH=/home/pi/Murmura/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/Murmura/venv/bin/python /home/pi/Murmura/mur-conductor/mur_conductor.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mur-conductor

[Install]
WantedBy=multi-user.target
